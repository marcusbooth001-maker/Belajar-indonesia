---
import SpeakerIcon from './SpeakerIcon.astro';

const { items, filterable = false } = Astro.props;

function searchText(item) {
  return [item.indonesian, item.english, item.root, item.standard, item.colloquialVariant, item.theme]
    .filter(Boolean)
    .join(' ');
}
---

<div class="table-scroll" tabindex="0" role="region" aria-label="Vocabulary">
  <table class="vocab-table">
    <thead>
      <tr>
        <th scope="col">Indonesian</th>
        <th scope="col">English</th>
        <th scope="col">Root</th>
        <th scope="col">Standard form</th>
        {filterable && <th scope="col">Theme</th>}
        {filterable && <th scope="col">Term</th>}
      </tr>
    </thead>
    <tbody>
      {
        items.map((item) => (
          <tr
            data-vocab-row={filterable ? '' : undefined}
            data-id={item.id}
            data-term={item.term}
            data-theme={item.theme}
            data-colloquial={String(item.colloquial)}
            data-slang={String(item.slang)}
            data-indonesian={item.indonesian}
            data-english={item.english}
            data-root={item.root || ''}
            data-standard={item.standard || ''}
            data-variant={item.colloquialVariant || ''}
            data-search={searchText(item)}
          >
            <td lang="id">
              <span class="word-line">
                <button
                  type="button"
                  class="icon-play"
                  data-play-word
                  aria-pressed="false"
                  aria-label={`Play ${item.indonesian}, then English`}
                >
                  <SpeakerIcon />
                </button>
                <span>{item.indonesian}</span>
              </span>
              {item.colloquial && !item.colloquialVariant && <span class="badge">Colloquial</span>}
              {item.colloquialVariant && (
                <span class="badge">Colloquial form: {item.colloquialVariant}</span>
              )}
              {item.slang && <span class="badge slang">Slang</span>}
            </td>
            <td>{item.english}</td>
            <td lang="id">
              {item.root || <span aria-hidden="true">—</span>}
              {!item.root && <span class="visually-hidden">None</span>}
            </td>
            <td lang="id">
              {item.standard || <span aria-hidden="true">—</span>}
              {!item.standard && <span class="visually-hidden">None</span>}
            </td>
            {filterable && <td>{item.theme}</td>}
            {filterable && <td>{item.term}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<script>
  import { wordAudioUrl } from '../lib/audio-url.js';
  import { createWordPlayer } from '../lib/word-player.js';

  // Term pages render this table once per theme. Bind playback a single time.
  if (!window.__belajarWordTable) {
    window.__belajarWordTable = true;
    const player = createWordPlayer();
    let currentButton = null;

    function setPressed(button, pressed) {
      if (!button) return;
      button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
      const row = button.closest('tr');
      const word = row?.dataset.indonesian || 'this word';
      button.setAttribute('aria-label', pressed ? `Pause ${word}` : `Play ${word}, then English`);
    }

    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-play-word]');
      if (!button) return;
      const row = button.closest('tr');
      const id = row?.dataset.id;
      if (!id) return;
      if (currentButton === button && player.active && !player.paused) {
        player.pause();
        return;
      }
      if (currentButton === button && player.active && player.paused) {
        setPressed(button, true);
        player.resume()?.catch(() => setPressed(button, false));
        return;
      }
      if (currentButton && currentButton !== button) setPressed(currentButton, false);
      currentButton = button;
      setPressed(button, true);
      player.play(
        [
          {
            src: wordAudioUrl(id, 'id'),
            title: row.dataset.indonesian || id,
            artist: row.dataset.english || 'Belajar Indonesia',
            album: 'Vocabulary',
          },
          {
            src: wordAudioUrl(id, 'en'),
            title: row.dataset.english || id,
            artist: row.dataset.indonesian || 'Belajar Indonesia',
            album: 'Vocabulary',
          },
        ],
        {
          onPlayState: (playing) => {
            if (currentButton === button) setPressed(button, playing);
          },
          onEnd: () => {
            if (currentButton === button) setPressed(button, false);
          },
          onError: () => {
            if (currentButton === button) setPressed(button, false);
          },
        },
      );
    });
  }
</script>
