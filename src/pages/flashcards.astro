---
import Base from '../layouts/Base.astro';
import SpeakerIcon from '../components/SpeakerIcon.astro';
import WalkingDownloads from '../components/WalkingDownloads.astro';
import { siteUrl } from '../lib/url.js';
import course from '../data/course.json';
---

<Base title="Flashcards · Belajar Indonesia" current="flashcards" description="Practise course vocabulary with flashcards and audio saved in this browser.">
  <article class="page">
    <h1>Flashcards</h1>
    <p>
      Choose a term and a theme, then flip each card. Mark a card known or unknown. Progress is saved in this browser only.
      Play speaks the front of the card. Listen plays Indonesian, then English, and moves on through this deck.
      The full lists are on the <a href={siteUrl('/vocabulary/')}>vocabulary page</a>.
    </p>
    <noscript>
      <p class="noscript">Flashcards need JavaScript. You can still read every item on the vocabulary page, and the walking audio links below still download.</p>
    </noscript>
    <div class="study-layout">
      <form id="deck-controls" class="study-controls">
        <label>
          Term
          <select id="deck-term" name="term">
            <option value="all">All terms</option>
            {course.termMeta.map((term) => <option value={term.n}>Term {term.n}: {term.title}</option>)}
          </select>
        </label>
        <label>
          Theme
          <select id="deck-theme" name="theme">
            <option value="all">All themes</option>
          </select>
        </label>
        <label>
          Direction
          <select id="deck-direction" name="dir">
            <option value="id">Indonesian to English</option>
            <option value="en">English to Indonesian</option>
          </select>
        </label>
        <label>
          Which cards
          <select id="deck-pool" name="pool">
            <option value="all">All cards</option>
            <option value="remaining">Not yet known</option>
            <option value="unknown">Unknown</option>
            <option value="known">Known</option>
          </select>
        </label>
        <label>
          <span>Order</span>
          <span class="keys"><input id="deck-shuffle" type="checkbox" /> Shuffle</span>
        </label>
        <label>
          <span>Audio</span>
          <span class="keys"><input id="deck-autoplay" type="checkbox" /> Auto-play</span>
        </label>
        <button type="button" class="secondary" id="shuffle-again" hidden>Shuffle again</button>
        <button type="button" class="ghost" id="reset-progress">Reset progress</button>
        <p class="keys" id="reset-note" hidden>This clears known and unknown marks stored on this device.</p>
      </form>

      <div>
        <div class="progress-wrap">
          <div
            id="deck-bar"
            class="bar"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="1"
            aria-valuenow="0"
            aria-label="Known cards in this deck"
          >
            <span id="bar-known" class="bar-known"></span>
            <span id="bar-unknown" class="bar-unknown"></span>
          </div>
          <p id="deck-progress" aria-live="polite">Loading cards…</p>
        </div>

        <article class="study-card" id="study-card">
          <p class="eyebrow" id="card-kicker">Term</p>
          <p class="study-word" id="card-prompt"></p>
          <div id="card-badges"></div>
          <p class="study-answer" id="card-answer" hidden></p>
          <p class="study-extra" id="card-extra" hidden></p>
          <div class="study-actions">
            <button type="button" class="secondary with-icon" id="play-card">
              <SpeakerIcon />
              <span id="play-card-label">Play</span>
            </button>
            <button type="button" id="flip">Show answer</button>
            <button type="button" class="secondary" id="mark-known" hidden>Known</button>
            <button type="button" class="ghost" id="mark-unknown" hidden>Unknown</button>
          </div>
          <p class="keys audio-status" id="card-audio-status" aria-live="polite"></p>
        </article>
        <div class="study-nav">
          <button type="button" class="secondary" id="prev">Previous</button>
          <span id="card-position">Card 0 of 0</span>
          <button type="button" class="secondary" id="next">Next</button>
        </div>
        <p class="keys">Keyboard: F flips the card, P plays it, K marks known, U marks unknown, and the arrow keys move through the deck. Word audio uses a computer-generated voice. Auto-play speaks the front of each new card.</p>

        <section class="listen-panel" aria-labelledby="listen-heading">
          <h2 id="listen-heading">Listen</h2>
          <p>
            Hands-free practice for the cards in this filter. Each one plays in Indonesian, then English, then the next card.
            Play, pause and skip keep working from the lock screen, including with the phone screen off.
          </p>
          <div class="study-actions listen-actions">
            <button type="button" id="listen-play">Play</button>
            <button type="button" class="secondary" id="listen-pause" disabled>Pause</button>
            <button type="button" class="secondary" id="listen-skip" disabled>Skip</button>
          </div>
          <p class="keys" id="listen-status" aria-live="polite"></p>
        </section>
      </div>
    </div>
    <WalkingDownloads />
  </article>

<script>
  import vocab from '../data/vocab.json';
  import { filterDeck, promptEnglish, shuffleItems, summarise } from '../lib/deck.js';
  import { wordAudioUrl } from '../lib/audio-url.js';
  import { createWordPlayer } from '../lib/word-player.js';

  const STORAGE_KEY = 'belajar-indonesia.progress.v1';
  const AUTOPLAY_KEY = 'belajar-indonesia.flashcard-autoplay.v1';
  const termSelect = document.querySelector('#deck-term');
  const themeSelect = document.querySelector('#deck-theme');
  const directionSelect = document.querySelector('#deck-direction');
  const poolSelect = document.querySelector('#deck-pool');
  const shuffleBox = document.querySelector('#deck-shuffle');
  const autoplayBox = document.querySelector('#deck-autoplay');
  const shuffleAgain = document.querySelector('#shuffle-again');
  const resetButton = document.querySelector('#reset-progress');
  const resetNote = document.querySelector('#reset-note');
  const progressText = document.querySelector('#deck-progress');
  const bar = document.querySelector('#deck-bar');
  const barKnown = document.querySelector('#bar-known');
  const barUnknown = document.querySelector('#bar-unknown');
  const kicker = document.querySelector('#card-kicker');
  const prompt = document.querySelector('#card-prompt');
  const badges = document.querySelector('#card-badges');
  const answer = document.querySelector('#card-answer');
  const extra = document.querySelector('#card-extra');
  const flipButton = document.querySelector('#flip');
  const playButton = document.querySelector('#play-card');
  const playLabel = document.querySelector('#play-card-label');
  const cardAudioStatus = document.querySelector('#card-audio-status');
  const knownButton = document.querySelector('#mark-known');
  const unknownButton = document.querySelector('#mark-unknown');
  const prevButton = document.querySelector('#prev');
  const nextButton = document.querySelector('#next');
  const position = document.querySelector('#card-position');
  const listenPlay = document.querySelector('#listen-play');
  const listenPause = document.querySelector('#listen-pause');
  const listenSkip = document.querySelector('#listen-skip');
  const listenStatus = document.querySelector('#listen-status');
  const player = createWordPlayer();

  const themes = [];
  const seen = new Set();
  for (const item of vocab) {
    const key = `${item.term}::${item.theme}`;
    if (seen.has(key)) continue;
    seen.add(key);
    themes.push({ term: item.term, theme: item.theme });
  }

  let progress = loadProgress();
  let index = 0;
  let flipped = false;
  let shuffledIds = null;
  let resetArmed = false;
  let shownId = null;
  let listening = false;
  let listenPaused = false;
  let speechKey = '';

  function loadProgress() {
    try {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      return stored && typeof stored === 'object' ? stored : {};
    } catch {
      return {};
    }
  }

  function saveProgress() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
  }

  function loadAutoplay() {
    try {
      return localStorage.getItem(AUTOPLAY_KEY) === '1';
    } catch {
      return false;
    }
  }

  function saveAutoplay(enabled) {
    try {
      localStorage.setItem(AUTOPLAY_KEY, enabled ? '1' : '0');
    } catch {
      /* Private browsing can block storage. The toggle still works for this visit. */
    }
  }

  function fillThemes() {
    const term = termSelect.value;
    const current = themeSelect.value;
    const available = themes.filter((theme) => term === 'all' || String(theme.term) === String(term));
    themeSelect.replaceChildren(new Option('All themes', 'all'));
    for (const theme of available) themeSelect.append(new Option(theme.theme, theme.theme));
    themeSelect.value = [...themeSelect.options].some((option) => option.value === current) ? current : 'all';
  }

  function currentDeck() {
    const filtered = filterDeck(vocab, {
      term: termSelect.value,
      theme: themeSelect.value,
      pool: poolSelect.value,
      progress,
    });
    if (!shuffleBox.checked) return filtered;
    if (!shuffledIds) shuffledIds = shuffleItems(filtered).map((item) => item.id);
    const byId = new Map(filtered.map((item) => [item.id, item]));
    return shuffledIds.map((id) => byId.get(id)).filter(Boolean);
  }

  function setFlipped(next) {
    flipped = next;
    answer.hidden = !flipped;
    extra.hidden = !flipped;
    knownButton.hidden = !flipped;
    unknownButton.hidden = !flipped;
    flipButton.textContent = flipped ? 'Hide answer' : 'Show answer';
  }

  function frontIsIndonesian() {
    return directionSelect.value !== 'en' ? !flipped : flipped;
  }

  function speechFor(item) {
    const indonesian = frontIsIndonesian();
    const text = indonesian ? item.indonesian : item.english;
    return {
      key: `${item.id}:${indonesian ? 'id' : 'en'}`,
      text,
      clip: {
        src: wordAudioUrl(item.id, indonesian ? 'id' : 'en'),
        title: text,
        artist: 'Belajar Indonesia',
        album: `Term ${item.term} · ${item.theme}`,
      },
    };
  }

  function listenClips(item) {
    return [
      {
        src: wordAudioUrl(item.id, 'id'),
        lang: 'id',
        title: item.indonesian,
        artist: item.english,
        album: `Term ${item.term} · ${item.theme}`,
      },
      {
        src: wordAudioUrl(item.id, 'en'),
        lang: 'en',
        title: item.english,
        artist: item.indonesian,
        album: `Term ${item.term} · ${item.theme}`,
      },
    ];
  }

  function setCardPlayState(playing) {
    playLabel.textContent = playing ? 'Pause' : 'Play';
    playButton.setAttribute('aria-pressed', playing ? 'true' : 'false');
  }

  function updateListenUi() {
    const deck = currentDeck();
    const hasCards = deck.length > 0;
    listenPlay.disabled = !hasCards || (listening && !listenPaused);
    listenPause.disabled = !listening || listenPaused;
    listenSkip.disabled = !listening;
    listenPlay.setAttribute('aria-label', listening && listenPaused ? 'Resume listening' : 'Play this deck');
    listenPause.setAttribute('aria-label', 'Pause listening');
    listenSkip.setAttribute('aria-label', 'Skip to the next card');
  }

  function sessionActions() {
    return {
      play: () => resumeListen(),
      pause: () => pauseListen(),
      nexttrack: () => skipListen(1),
      previoustrack: () => skipListen(-1),
      stop: () => stopListen('Stopped.'),
    };
  }

  function stopListen(message = '') {
    const wasListening = listening;
    listening = false;
    listenPaused = false;
    player.stop();
    speechKey = '';
    setCardPlayState(false);
    if (message) listenStatus.textContent = message;
    else if (wasListening) listenStatus.textContent = '';
    updateListenUi();
  }

  function playListenItem(item) {
    if (!item) {
      stopListen('No cards match these filters.');
      render();
      return;
    }
    listening = true;
    listenPaused = false;
    const deck = currentDeck();
    const at = deck.findIndex((entry) => entry.id === item.id);
    if (at >= 0) index = at;
    setFlipped(false);
    speechKey = '';
    setCardPlayState(false);
    render({ speak: false });
    player.play(listenClips(item), {
      session: true,
      actions: sessionActions(),
      onClip: (clip) => {
        if (clip.lang === 'en') {
          setFlipped(true);
          if (!extra.textContent) extra.hidden = true;
        }
        playButton.setAttribute('aria-label', `Play ${clip.title}`);
        const place = `Card ${(index + 1).toLocaleString('en-GB')} of ${currentDeck().length.toLocaleString('en-GB')}`;
        listenStatus.textContent = clip.lang === 'id'
          ? `Indonesian: ${item.indonesian}. ${place}.`
          : `English: ${item.english}. ${place}.`;
        updateListenUi();
      },
      onEnd: () => {
        if (!listening || listenPaused) return;
        const latest = currentDeck();
        const place = latest.findIndex((entry) => entry.id === item.id);
        if (place < 0 || place + 1 >= latest.length) {
          stopListen('End of the deck.');
          return;
        }
        index = place + 1;
        playListenItem(latest[index]);
      },
      onError: (error) => {
        if (error?.name === 'NotAllowedError') {
          listening = false;
          listenPaused = false;
          player.stop();
          listenStatus.textContent = 'Tap Play to start listening.';
          updateListenUi();
          return;
        }
        const latest = currentDeck();
        const place = latest.findIndex((entry) => entry.id === item.id);
        if (place >= 0 && place + 1 < latest.length) {
          index = place + 1;
          playListenItem(latest[index]);
          return;
        }
        stopListen('The audio could not be played.');
      },
    });
    updateListenUi();
  }

  function pauseListen() {
    if (!listening) return;
    listenPaused = true;
    player.pause();
    listenStatus.textContent = 'Paused.';
    updateListenUi();
  }

  function resumeListen() {
    if (!listening) {
      const deck = currentDeck();
      if (deck[index]) playListenItem(deck[index]);
      return;
    }
    listenPaused = false;
    const pending = player.resume();
    pending?.catch(() => {
      listenStatus.textContent = 'The audio could not be played in this browser.';
    });
    updateListenUi();
  }

  function skipListen(delta) {
    if (!listening) return;
    const deck = currentDeck();
    if (!deck.length) return;
    const next = index + delta;
    if (delta > 0 && next >= deck.length) {
      stopListen('End of the deck.');
      return;
    }
    index = Math.max(0, next);
    playListenItem(deck[index]);
  }

  function speakFront(item = currentDeck()[index]) {
    if (!item || listening) return;
    const speech = speechFor(item);
    speechKey = speech.key;
    cardAudioStatus.textContent = '';
    playButton.setAttribute('aria-label', `Play ${speech.text}`);
    player.play([speech.clip], {
      onPlayState: (playing) => {
        if (speechKey === speech.key) setCardPlayState(playing);
      },
      onEnd: () => {
        if (speechKey === speech.key) {
          speechKey = '';
          setCardPlayState(false);
        }
      },
      onError: (error) => {
        setCardPlayState(false);
        cardAudioStatus.textContent = error?.name === 'NotAllowedError'
          ? 'Tap Play to start the sound.'
          : 'The audio could not be played.';
      },
    });
  }

  function render({ speak = true } = {}) {
    const deck = currentDeck();
    const stats = summarise(
      filterDeck(vocab, { term: termSelect.value, theme: themeSelect.value, pool: 'all', progress }),
      progress,
    );
    if (index >= deck.length) index = Math.max(0, deck.length - 1);
    if (index < 0) index = 0;
    const item = deck[index];
    const direction = directionSelect.value;
    progressText.textContent = `Known ${stats.known.toLocaleString('en-GB')} · Unknown ${stats.unknown.toLocaleString('en-GB')} · Unseen ${stats.unseen.toLocaleString('en-GB')} · Deck ${deck.length.toLocaleString('en-GB')}`;
    bar.setAttribute('aria-valuemax', String(Math.max(stats.total, 1)));
    bar.setAttribute('aria-valuenow', String(stats.known));
    bar.setAttribute('aria-label', `Known ${stats.known} of ${stats.total} cards in this deck`);
    const knownWidth = stats.total ? (stats.known / stats.total) * 100 : 0;
    const unknownWidth = stats.total ? (stats.unknown / stats.total) * 100 : 0;
    barKnown.style.width = `${knownWidth}%`;
    barUnknown.style.width = `${unknownWidth}%`;
    shuffleAgain.hidden = !shuffleBox.checked;

    if (!item) {
      kicker.textContent = 'Deck';
      prompt.textContent = 'No cards match these filters.';
      prompt.lang = 'en-GB';
      badges.replaceChildren();
      answer.hidden = true;
      extra.hidden = true;
      flipButton.hidden = true;
      playButton.hidden = true;
      knownButton.hidden = true;
      unknownButton.hidden = true;
      position.textContent = 'Card 0 of 0';
      prevButton.disabled = true;
      nextButton.disabled = true;
      shownId = null;
      updateListenUi();
      return;
    }

    flipButton.hidden = false;
    playButton.hidden = false;
    const showIndonesianFirst = direction === 'id';
    kicker.textContent = `Term ${item.term} · ${item.theme}`;
    prompt.textContent = showIndonesianFirst ? item.indonesian : promptEnglish(item.english);
    prompt.lang = showIndonesianFirst ? 'id' : 'en-GB';
    answer.textContent = showIndonesianFirst ? item.english : item.indonesian;
    answer.lang = showIndonesianFirst ? 'en-GB' : 'id';
    const notes = [];
    if (item.root) notes.push(`Root: ${item.root}`);
    if (item.standard) notes.push(`Standard form: ${item.standard}`);
    if (item.colloquialVariant) notes.push(`Colloquial form: ${item.colloquialVariant}`);
    if (!showIndonesianFirst) notes.push(`Full gloss: ${item.english}`);
    extra.textContent = notes.join(' · ');
    badges.replaceChildren();
    if (item.colloquial && !item.colloquialVariant) badges.append(badge('Colloquial', 'badge'));
    if (item.slang) badges.append(badge('Slang', 'badge slang'));
    const mark = progress[item.id];
    if (mark === 'known') badges.append(badge('Marked known', 'badge'));
    if (mark === 'unknown') badges.append(badge('Marked unknown', 'badge slang'));
    setFlipped(flipped);
    if (!notes.length) extra.hidden = true;
    position.textContent = `Card ${(index + 1).toLocaleString('en-GB')} of ${deck.length.toLocaleString('en-GB')}`;
    prevButton.disabled = index === 0;
    nextButton.disabled = index >= deck.length - 1;
    const speech = speechFor(item);
    if (speechKey !== speech.key) playButton.setAttribute('aria-label', `Play ${speech.text}`);
    const cardChanged = item.id !== shownId;
    shownId = item.id;
    updateListenUi();
    if (speak && cardChanged && autoplayBox.checked && !listening && !flipped) speakFront(item);
  }

  function badge(text, className) {
    const node = document.createElement('span');
    node.className = className;
    node.textContent = text;
    return node;
  }

  function writeUrl() {
    const params = new URLSearchParams();
    if (termSelect.value !== 'all') params.set('term', termSelect.value);
    if (themeSelect.value !== 'all') params.set('theme', themeSelect.value);
    if (directionSelect.value !== 'id') params.set('dir', directionSelect.value);
    if (poolSelect.value !== 'all') params.set('pool', poolSelect.value);
    if (shuffleBox.checked) params.set('shuffle', '1');
    const query = params.toString();
    window.history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
  }

  function resetPosition() {
    index = 0;
    shuffledIds = null;
    setFlipped(false);
    writeUrl();
    if (listening) {
      const deck = currentDeck();
      if (!deck.length) stopListen('No cards match these filters.');
      else playListenItem(deck[0]);
      return;
    }
    render();
  }

  function mark(status) {
    const deck = currentDeck();
    const item = deck[index];
    if (!item) return;
    progress[item.id] = status;
    saveProgress();
    const nextDeck = currentDeck();
    const stillHere = nextDeck[index] && nextDeck[index].id === item.id;
    if (stillHere) {
      if (index < nextDeck.length - 1) index += 1;
    } else if (index >= nextDeck.length) {
      index = Math.max(0, nextDeck.length - 1);
    }
    setFlipped(false);
    if (listening) {
      const latest = currentDeck();
      if (!latest[index]) stopListen('End of the deck.');
      else playListenItem(latest[index]);
      return;
    }
    render();
  }

  function go(delta) {
    const deck = currentDeck();
    const next = index + delta;
    if (next < 0 || next >= deck.length) return;
    index = next;
    setFlipped(false);
    if (listening) {
      playListenItem(deck[index]);
      return;
    }
    render();
  }

  termSelect.addEventListener('change', () => {
    fillThemes();
    resetPosition();
  });
  themeSelect.addEventListener('change', resetPosition);
  directionSelect.addEventListener('change', () => {
    setFlipped(false);
    writeUrl();
    render({ speak: false });
    if (autoplayBox.checked && !listening) speakFront();
  });
  poolSelect.addEventListener('change', resetPosition);
  shuffleBox.addEventListener('change', resetPosition);
  autoplayBox.addEventListener('change', () => {
    saveAutoplay(autoplayBox.checked);
    if (autoplayBox.checked && !listening) speakFront();
  });
  shuffleAgain.addEventListener('click', () => {
    shuffledIds = null;
    index = 0;
    setFlipped(false);
    if (listening) {
      const deck = currentDeck();
      if (deck.length) playListenItem(deck[0]);
      else stopListen('No cards match these filters.');
      return;
    }
    render();
  });
  flipButton.addEventListener('click', () => {
    if (flipButton.hidden) return;
    setFlipped(!flipped);
    render({ speak: false });
  });
  playButton.addEventListener('click', () => {
    const item = currentDeck()[index];
    if (!item) return;
    if (listening) stopListen();
    const speech = speechFor(item);
    if (speechKey === speech.key && player.active && !player.paused) {
      player.pause();
      return;
    }
    if (speechKey === speech.key && player.active && player.paused) {
      player.resume()?.catch(() => {
        cardAudioStatus.textContent = 'The audio could not be played.';
      });
      return;
    }
    speakFront(item);
  });
  listenPlay.addEventListener('click', () => resumeListen());
  listenPause.addEventListener('click', () => pauseListen());
  listenSkip.addEventListener('click', () => skipListen(1));
  knownButton.addEventListener('click', () => mark('known'));
  unknownButton.addEventListener('click', () => mark('unknown'));
  prevButton.addEventListener('click', () => go(-1));
  nextButton.addEventListener('click', () => go(1));
  resetButton.addEventListener('click', () => {
    if (!resetArmed) {
      resetArmed = true;
      resetButton.textContent = 'Confirm reset';
      resetNote.hidden = false;
      return;
    }
    progress = {};
    saveProgress();
    resetArmed = false;
    resetButton.textContent = 'Reset progress';
    resetNote.hidden = true;
    setFlipped(false);
    if (listening) {
      const deck = currentDeck();
      if (!deck.length) stopListen('No cards match these filters.');
      else playListenItem(deck[Math.min(index, deck.length - 1)]);
      return;
    }
    render();
  });

  document.addEventListener('keydown', (event) => {
    const tag = document.activeElement?.tagName;
    if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
    if (event.key === 'f' || event.key === 'F') {
      event.preventDefault();
      flipButton.click();
    } else if (event.key === 'p' || event.key === 'P') {
      if (!playButton.hidden) {
        event.preventDefault();
        playButton.click();
      }
    } else if (event.key === 'k' || event.key === 'K') {
      if (!knownButton.hidden) mark('known');
    } else if (event.key === 'u' || event.key === 'U') {
      if (!unknownButton.hidden) mark('unknown');
    } else if (event.key === 'ArrowRight') {
      nextButton.click();
    } else if (event.key === 'ArrowLeft') {
      prevButton.click();
    }
  });

  const params = new URLSearchParams(window.location.search);
  if (params.get('term')) termSelect.value = params.get('term');
  fillThemes();
  if (params.get('theme')) themeSelect.value = params.get('theme');
  if (![...themeSelect.options].some((option) => option.value === themeSelect.value)) themeSelect.value = 'all';
  if (params.get('dir') === 'en' || params.get('dir') === 'id') directionSelect.value = params.get('dir');
  if (params.get('pool')) poolSelect.value = params.get('pool');
  shuffleBox.checked = params.get('shuffle') === '1';
  autoplayBox.checked = loadAutoplay();
  render();
  updateListenUi();
</script>
</Base>
